{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["remotion.config.ts", "src/**/*.ts", "src/**/*.tsx", "channels/**/*.ts", "channels/**/*.tsx"]
}
